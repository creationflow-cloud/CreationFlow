generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       Product[]
  templates      ProductTemplate[]
  configurations Configuration[]
  renderJobs     RenderJob[]
}

model Product {
  id          String   @id @default(cuid())
  workspaceId String
  externalId  String?
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  templates      ProductTemplate[]
  configurations Configuration[]

  @@index([workspaceId])
  @@index([workspaceId, externalId])
}

model ProductTemplate {
  id             String   @id @default(cuid())
  workspaceId    String
  productId      String?
  documentSchema Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  configurations Configuration[]

  @@index([workspaceId])
  @@index([productId])
}

model Configuration {
  id         String              @id @default(cuid())
  workspaceId String
  productId  String?
  templateId String?
  document   Json
  status     ConfigurationStatus @default(DRAFT)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product    Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  template   ProductTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  renderJobs RenderJob[]

  @@index([workspaceId])
  @@index([productId])
  @@index([templateId])
  @@index([status])
}

model RenderJob {
  id              String          @id @default(cuid())
  workspaceId     String
  configurationId String?
  status          RenderJobStatus @default(PENDING)
  output          Json?
  errorMessage    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  configuration Configuration? @relation(fields: [configurationId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([configurationId])
  @@index([status])
}

enum ConfigurationStatus {
  DRAFT
  CART
  ORDERED
  ARCHIVED
}

enum RenderJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}
