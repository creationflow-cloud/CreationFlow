# CreationFlow local development Docker environment
# Copy this file to .env for local use. Values are placeholders only.

COMPOSE_PROJECT_NAME=creationflow

POSTGRES_PORT=5432
POSTGRES_DB=creationflow
POSTGRES_USER=creationflow
POSTGRES_PASSWORD=creationflow_dev_password
DATABASE_URL=postgresql://creationflow:creationflow_dev_password@localhost:5432/creationflow?schema=public

REDIS_PORT=6379

API_PORT=3000
EDITOR_PORT=3001
ADMIN_PORT=3002
