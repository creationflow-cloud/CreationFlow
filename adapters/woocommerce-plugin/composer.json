{
    "name": "creationflow/woocommerce-plugin",
    "description": "WooCommerce adapter for connecting a shop to a self-hosted CreationFlow server.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "CreationFlow\\WooCommerce\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CreationFlow\\WooCommerce\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:install": "composer install --no-interaction --prefer-dist"
    }
}
